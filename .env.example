# Local development only. These Postgres values match the examples and e2e tests.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=example_user
POSTGRES_PASSWORD=example_password
POSTGRES_DB=example_db

PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=example_password

SQLSTREAMS_ADMIN_DATABASE_URL=postgres://example_user:example_password@localhost:5432/example_db?sslmode=disable
