.env
.DS_Store

# monorepo crap
go.work
go.work.sum

# built binaries live in .bin/ (just build-e2e <test>)
/.bin/*
!/.bin/.gitkeep

# benchmark scratch -- only the writeup is tracked
.bench/idempotency/*
!.bench/idempotency/RESULTS.md

# reliability-lab runs: results/<scenario>/runs.jsonl is tracked, the
# per-run directories and the recipe's scratch files are not
.bench/results/*/*/
.bench/results/fingerprint.json
.bench/results/stats.jsonl

# go build run inside a main package drops a binary named for its directory;
# go test -c and profiling flags drop *.test and *.prof beside the source
/cmd/sqlstreams/sqlstreams
/.tools/codeexport/codeexport
/.tools/compat/compat
/.tools/compatexport/compatexport
/.bench/claim/claim
/.bench/reliability
/.bench/.bench
/.bench/scale/projector/projector
/.bench/*/driver/driver
*.test
*.prof
*.pprof
__debug_bin*

# Native scratch benchmark evidence is retained locally.
.bench/scratchnative/results/evidence/

# goreleaser output
/.dist/

.claude

# Evidence selected for the public throughput report.
!.bench/results/published/2026-09-11/
