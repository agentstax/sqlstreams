.env
.DS_Store

# monorepo crap
go.work
go.work.sum

# Prior-release worktrees used by the compatibility lab
/.compat/

# built binaries live in .bin/ (just build-e2e <test>)
/.bin/*
!/.bin/.gitkeep

# Benchmark runs: results/<scenario>/runs.jsonl is tracked, the
# per-run directories and the recipe's scratch files are not
.bench/results/*/*/
.bench/results/fingerprint.json
.bench/results/stats.jsonl

# go build run inside a main package drops a binary named for its directory;
# go test -c and profiling flags drop *.test and *.prof beside the source
/cmd/sqlstreams/sqlstreams
/.tools/codeexport/codeexport
/.tools/compat/compat
/.tools/compatexport/compatexport
/.bench/bench
/.bench/.bench
*.test
*.prof
*.pprof
__debug_bin*

# goreleaser output
/.dist/

.claude

# Evidence selected for the public throughput report.
!.bench/results/published/2026-09-11/
