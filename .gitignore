.env
.DS_Store

# monorepo crap
go.work
go.work.sum

# built binaries live in bin/ (just build-lab <lab>)
/bin/*
!/bin/.gitkeep

# bench scratch -- only the writeup is tracked
bench/idempotency/*
!bench/idempotency/RESULTS.md

# reliability-lab run records -- results/<scenario>/<timestamp>/
bench/reliability/results/

# go build run inside a main package drops a binary named for its directory;
# go test -c and profiling flags drop *.test and *.prof beside the source
/cmd/vulkan/vulkan
/tools/codeexport/codeexport
/tools/compat/compat
/tools/compatexport/compatexport
/bench/claim/claim
/bench/reliability/reliability
/bench/scale/projector/projector
/bench/*/driver/driver
*.test
*.prof
*.pprof
__debug_bin*
