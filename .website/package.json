{
	"name": "website",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build && pagefind --site dist",
		"preview": "astro preview",
		"astro": "astro",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"lint": "eslint .",
		"test": "vitest run src",
		"flows": "playwright test",
		"format": "prettier --write .",
		"verify": "prettier --check . && eslint . && stylelint \"src/**/*.css\" && astro check && svelte-check --threshold error && remark src/content/docs --ext md,mdx --quiet --frail && vale --minAlertLevel=error src/content/docs && vitest run src && playwright test"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.1",
		"@astrojs/mdx": "^8.0.0",
		"@astrojs/sitemap": "^3.7.4",
		"@astrojs/svelte": "^9.0.1",
		"@codemirror/commands": "^6.11.0",
		"@codemirror/lang-sql": "^6.10.0",
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "^6.7.4",
		"@codemirror/view": "^6.43.11",
		"@electric-sql/pglite": "^0.5.8",
		"@lezer/highlight": "^1.2.3",
		"astro": "^7.3.2",
		"sharp": "^0.35.4",
		"svelte": "^5.57.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@storybook/addon-svelte-csf": "^5.1.3",
		"@storybook/svelte-vite": "^10.6.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@vvago/vale": "^3.20.0",
		"eslint": "^10.10.0",
		"eslint-plugin-astro": "^3.1.0",
		"eslint-plugin-svelte": "^3.23.0",
		"mdx2vast": "^0.5.0",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-svelte": "^4.1.1",
		"remark-cli": "^12.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-lint-first-heading-level": "^4.0.1",
		"remark-lint-heading-increment": "^4.0.1",
		"remark-mdx": "^3.1.1",
		"storybook": "^10.5.10",
		"stylelint": "^17.15.0",
		"stylelint-declaration-strict-value": "^1.12.1",
		"svelte-check": "^4.7.6",
		"svelte-preprocess": "^6.0.5",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2",
		"vitest": "^5.0.0",
		"wrangler": "^4.100.0"
	}
}
