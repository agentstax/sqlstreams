# 1 KB messages with automatic batching and one group; short exploration, not a sustainable verdict

[input]
topic        orders       DeliveryLogMode failures
consumers    processor    handler fail rate 0, 3 retries then dead, batch 100, queue 0, concurrency 0, idle poll 10ms
producer     batch concurrency 4 per topic
workload     automatic batching true, payload bytes 1000, pool max 16, batch size 100
duration     30s

[shape]
warm:    steady 2000/s 10s
hold:    steady 2000/s 20s

at 0m    consumers 2

[expect]
lost                  0
unexpected            0
recovered             report
undelivered           0
duplicates            report
unbucketed            0
reclaims              0
dead                  0
schedule_kept         0
backlog_bounded       0
generator_headroom    0
