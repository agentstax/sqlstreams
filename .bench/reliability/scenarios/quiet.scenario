# the hour-long quiet run: constant load, fixed consumers, no chaos, nothing may move

[input]
stream       orders           DeliveryLogMode all
consumers    fraud-scoring    handler fail rate 0, 3 retries then dead
duration     60m

[shape]
hold:    steady 200/s 60m

at 0m    consumers 3

[expect]
lost                  0
unexpected            0
recovered             report
undelivered           0
duplicates            report
unbucketed            0
reclaims              0
dead                  0
schedule_kept         0
backlog_bounded       0
generator_headroom    0
