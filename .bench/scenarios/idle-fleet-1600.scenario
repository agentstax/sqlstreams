# the idle fleet over 1600 streams: nothing produced, one group on every stream, every replica running a session on each

[input]
stream       orders-1..orders-1600    DeliveryLogMode failures
consumers    fraud-scoring            handler fail rate 0, 3 retries then dead
workload     automatic batching false, payload bytes 0, pool max 64, batch size 0
duration     20m

[shape]
settle:    warmup steady 0/s per stream 10m
idle:      steady 0/s per stream 10m

at 0m    consumers 1

[expect]
lost                  0
unexpected            0
recovered             report
undelivered           0
duplicates            0
unbucketed            0
reclaims              0
dead                  0
backlog_bounded       0
generator_headroom    report
